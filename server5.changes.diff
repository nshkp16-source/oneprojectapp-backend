+    const hasText = cur.runs.some(r => r.text.trim());
+    if (hasText) blocks.push(cur); else if (cur.type !== 'li') blocks.push({ type: 'blank', runs: [] });
+    cur = null;
+  };
+  for (const m of String(html || '').matchAll(/<(\/?)([a-zA-Z][a-zA-Z0-9]*)([^>]*)>|([^<]+)/g)) {
